PORT=3000

# Duración de la partida en segundos (300 = 5 minutos, 30 para pruebas rápidas)
GAME_DURATION_SECONDS=300

# true = activa los endpoints /api/simulation (solo para desarrollo, NUNCA en producción)
SIMULATION_MODE=true

# (Opcional) API key de Euler Stream, el servicio que firma la conexión con TikTok LIVE.
# Sin key funciona con límites gratuitos. Es un SECRETO: nunca la subas a Git ni la pongas en el código.
EULER_API_KEY=


# URI de conexión a MongoDB Atlas (SECRETO: contiene tu contraseña de la base de datos)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/tikbattle?retryWrites=true&w=majority

# Clave para firmar los tokens JWT (SECRETO: texto largo y aleatorio, distinto en cada entorno)
JWT_SECRET=CAMBIAR_POR_UN_TEXTO_LARGO_Y_ALEATORIO

# Cuánto dura una sesión antes de tener que volver a iniciar sesión
JWT_EXPIRES_IN=7d

# (Opcional) DNS que usará Node para encontrar MongoDB Atlas.
# Úsalo si al arrancar aparece "querySrv ECONNREFUSED". Ejemplo: 8.8.8.8,1.1.1.1
DNS_SERVERS=

# (Opcional) Minutos sin uso tras los que una sala se libera de la memoria (por defecto 10)
ROOM_IDLE_MINUTES=10

# Dirección pública https del servidor. TikTok LIVE Studio SOLO acepta URLs https://
# Desarrollo: la da el túnel de Cloudflare (cambia cada vez que se abre el túnel):
#   "C:\Program Files (x86)\cloudflared\cloudflared.exe" tunnel --url http://localhost:3000
# Producción (Módulo 16): el dominio propio, ej. https://tikbattle.com
PUBLIC_URL=

# ===== Producción (Módulo 16) =====
# production = activa las comprobaciones de seguridad (el servidor NO arranca si SIMULATION_MODE=true,
# si JWT_SECRET es corto o si PUBLIC_URL no es https). En el servidor lo pone docker-compose.yml.
NODE_ENV=development

# Cuántos intermediarios hay delante del servidor, para saber la IP real de cada visitante:
# 1 = solo Caddy (Oracle + DuckDNS) · 2 = Cloudflare + Caddy · vacío = ninguno (desarrollo)
TRUST_PROXY=

# Cada cuántos segundos se guarda la partida en curso en MongoDB (por defecto 10)
SNAPSHOT_INTERVAL_SECONDS=10

# Copias de seguridad (npm run backup): carpeta y cuántas se guardan
BACKUP_DIR=
BACKUP_KEEP=7

# (Opcional) Probabilidad de que una partida tenga "2X final" (últimos 10 s valen el doble). Por defecto 0.35 (35 %).
# 0 = nunca, 1 = siempre (útil para probar la animación). En producción déjala vacía.
DOUBLE_FINAL_CHANCE=
