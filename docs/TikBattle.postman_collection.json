{
  "info": {
    "name": "TikBattle - API de pruebas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A. Registro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda el token automáticamente para las demás peticiones",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "  console.log(\"Token guardado\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Santiago\",\n  \"email\": \"tu_email@ejemplo.com\",\n  \"password\": \"una-contraseña-segura\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/register"
      }
    },
    {
      "name": "B. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda el token automáticamente para las demás peticiones",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "  console.log(\"Token guardado\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tu_email@ejemplo.com\",\n  \"password\": \"una-contraseña-segura\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "http://localhost:3000/api/auth/login"
      }
    },
    {
      "name": "C. Mi perfil",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/auth/me"
      }
    },
    {
